#Aget ENV

BOT_TOKEN=token
OPEN_AI_KEY=main_key_for_agent
CPP_SERVER_URL=http://127.0.0.1:8080
LLM_MODEL=gemma4
LLM_BASE_URL=https://ollama.com/v1
VOICE_LLM_MODEL=whisper-large-v3
VOICE_BASE_URL=https://api.groq.com/openai/v1
VOICE_TOKEN=token_voice
SPEECH_LLM_MODEL=qwen/qwen-audio-3.0-tts-flash
SPEECH_BASE_URL=https://openrouter.ai/api/v1
SPEECH_TOKEN=token_speech
# Voice ids come from the model: qwen/qwen-audio-3.0-tts-flash accepts
# longanhuan_v3.6 and loongjohn; any other id fails with HTTP 400.
SPEECH_VOICE=longanhuan_v3.6
# Leave unset: Qwen TTS rejects speed values other than 1.
# SPEECH_SPEED=1.0

# Group chat behaviour (see README)
GROUP_REPLIES_EPHEMERAL=true
GROUP_ACTIONS_EPHEMERAL=true
GROUP_ALLOW_REPLY_TO_BOT=false
GROUP_SAFE_MODE=true

# Document viewing (document_view): text PDFs are read instantly, OCR only
# runs for scans and image-only pages.
DOCUMENT_OCR_ENABLED=true
# "eslav" = Russian/Ukrainian/Belarusian, "cyrillic" = other Cyrillic languages
DOCUMENT_OCR_LANG=eslav
# Table structure extraction is slow (~70 s for 72 slides), so it is off.
DOCUMENT_TABLE_STRUCTURE=false
DOCUMENT_MAX_PAGES=100
DOCUMENT_MAX_FILE_MB=30
DOCUMENT_MAX_CHARS=50000

#Server ENV
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=pass
DB_NAME=db

GOOGLE_CLIENT_ID=id
GOOGLE_CLIENT_SECRET=secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# Google rejects a private-IP redirect URI unless both are sent; localhost does
# not need them, so they are optional.
# GOOGLE_DEVICE_ID=kira-ai-assistant
# GOOGLE_DEVICE_NAME=KiraAIAssistant

TOKEN_ENCRYPTION_KEY=encrypt
SESSION_COOKIE_NAME=random_state
SECRET_KEY=SuPeR_SeCrEt_KeY